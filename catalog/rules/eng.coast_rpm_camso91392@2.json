{
 "schema": "beam2ac.rule/2",
 "id": "eng.coast_rpm_camso91392",
 "version": 2,
 "target": "ac:engine.ini/COAST_REF/RPM",
 "kind": "computed",
 "transform": {
  "id": "ac_coast_ref",
  "params": {
   "output": "rpm",
   "law": "acs_least_squares"
  },
  "input_units": {
   "curve": "table:rpm->N·m",
   "ceiling": "rpm",
   "minimum": "rpm"
  },
  "output_unit": "rpm",
  "formula": "ac_coast_ref (src/ac/coast_ref.py coast_ref_least_squares): pendiente s = Σ t·x / Σ x² con x = rpm − MINIMUM sobre MINIMUM < rpm ≤ techo; RPM = último punto ≤ techo, TORQUE = s·(RPM − MINIMUM); NON_LINEARITY = 0; AC aplica freno(rpm) = s·(rpm − MINIMUM) (motor de AC)"
 },
 "scope": {
  "level": "family",
  "vehicle": "",
  "variant": "",
  "family": "automation_export",
  "conditions": []
 },
 "status": "provisional",
