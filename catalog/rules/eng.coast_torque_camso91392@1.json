 "kind": "computed",
 "transform": {
  "id": "ac_coast_ref",
  "params": {
   "output": "torque",
   "law": "acs_from_minimum",
   "round": 1
  },
  "input_units": {
   "curve": "table:rpm->N·m",
   "ceiling": "rpm",
   "minimum": "rpm"
  },
  "output_unit": "N·m",
  "formula": "ac_coast_ref (src/ac/coast_ref.py coast_ref_from_minimum): RPM, TORQUE = último punto (r, t) de la curva con r ≤ techo; NON_LINEARITY = 0; AC aplica freno(rpm) = TORQUE·(rpm − MINIMUM)/(RPM − MINIMUM) para rpm > MINIMUM y 0 por debajo (motor de AC)"
 },
 "scope": {
  "level": "family",
